# Database connection (PostgreSQL - Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/survey_platform?schema=public"

# Auth JWT secret (min 32 chars recommended)
JWT_SECRET="super-secret-jwt-key-min-32-chars-long-change-in-prod"

# Salt for hashing respondent IP addresses (privacy-preserving rate limiting & duplicate guard)
IP_HASH_SALT="ip-hash-salt-random-string-for-privacy-protection"

# Upstash Redis REST credentials (optional; local development uses an in-memory fallback)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public app URL for sharing survey links and callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
